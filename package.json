{
  "name": "@elonehoo/normalize-url",
  "type": "module",
  "version": "0.0.6",
  "description": "Normalize a URL",
  "author": "Elone Hoo <hi@elonehoo.me>",
  "license": "MIT",
  "homepage": "https://github.com/elonehoo/normalize-url#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elonehoo/normalize-url"
  },
  "bugs": "https://github.com/elonehoo/normalize-url/issues",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "*.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && unbuild",
    "release": "bumpp package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@elonehoo/rimraf": "0.0.1",
    "@types/node": "24.19.2",
    "bumpp": "12.3.0",
    "eslint": "10.13.0",
    "pnpm": "12.14.0",
    "typescript": "5.9.3",
    "unbuild": "^3.6.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
